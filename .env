# SonarCloud Configuration
# Get your token at: https://sonarcloud.io/account/security
#SONAR_TOKEN=your_sonar_token_here

# Optional: Override default SonarCloud URL
# SONAR_HOST_URL=https://sonarcloud.io

# Backend API Configuration
# URL base para a API do backend Java
# Exemplos:
#   - Localhost: http://localhost:8080
#   - Android Emulator: http://10.0.2.2:8080
#   - Dispositivo físico: http://192.168.1.7:8080 (ajuste o IP conforme necessário)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Força a exibição da tela de onboarding (para testes)
FORCE_SHOW_ONBOARDING=true

# Google OAuth2 Configuration
# ⚠️ ATENÇÃO: Precisa do Web Client ID, não do Client Secret!
# Formato correto: 123456789-abc.apps.googleusercontent.com
# Onde encontrar:
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Procure o OAuth 2.0 Client ID do tipo "Web application"
# 3. Copie o Client ID (não o Client Secret!)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1047433217870-r49q3eau6pq952hsrv8kc0o0f8anie7p.apps.googleusercontent.com

# iOS OAuth2 Client ID (para Custom Development Build no iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1047433217870-so83l9h9s4845lmdbup6gvln1khum3lf.apps.googleusercontent.com

# Google Client Secret (NÃO use no mobile, apenas no backend!)
# GOOGLE_CLIENT_SECRET=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