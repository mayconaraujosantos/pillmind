# SonarCloud Configuration
# Get your token at: https://sonarcloud.io/account/security
SONAR_TOKEN=your_sonar_token_here

# Optional: Override default SonarCloud URL
# SONAR_HOST_URL=https://sonarcloud.io

# API (pillmind-backend)
# Example local: http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth (Web Client ID)
# Get it from Google Cloud Console (OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com