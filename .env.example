# SonarCloud Configuration
# Get your token at: https://sonarcloud.io/account/security
SONAR_TOKEN=your_sonar_token_here

# Optional: Override default SonarCloud URL
# SONAR_HOST_URL=https://sonarcloud.io

# API (pillmind-backend)
# Example local: http://localhost:8080
# Celular na mesma rede: http://192.168.x.x:8080 (mesmo host do PC que roda o backend)
EXPO_PUBLIC_API_URL=http://localhost:8080

# URL pública das imagens MinIO (igual MINIO_PUBLIC_BASE_URL no backend).
# O backend costuma usar http://127.0.0.1:9000/pillmind; no celular use o IP da máquina:
# EXPO_PUBLIC_MINIO_PUBLIC_BASE_URL=http://192.168.1.7:9000/pillmind
# Se omitir, o app tenta deduzir o host a partir de EXPO_PUBLIC_API_URL na porta 9000 (dev/LAN).
# EXPO_PUBLIC_MINIO_PORT=9000

# Force onboarding screen (testing)
FORCE_SHOW_ONBOARDING=false

# Google OAuth (Web Client ID)
# Get it from Google Cloud Console (OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Google OAuth (iOS Client ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com